        <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">// ===== Save data from the server to a local CSV =====
// Output file (override with -Jout_file=/path/file.csv)
def path = props.getProperty(&apos;out_file&apos;, &apos;/Users/aqtar/Downloads/demoblaze_data1.csv&apos;)

// Values to save (variables created by your CSV/extractors)
def row = [
    new Date().format(&apos;yyyy-MM-dd HH:mm:ss&apos;),   // when
    ctx.getThread().getThreadName(),            // which virtual user
    vars.get(&apos;username&apos;)   ?: &apos;&apos;,
    vars.get(&apos;category&apos;)   ?: &apos;&apos;,
    vars.get(&apos;Prod_ID&apos;)    ?: &apos;&apos;,
    vars.get(&apos;Auth_Token&apos;) ?: &apos;&apos;,
    prev.getResponseCode(),                     // HTTP status of this request
    prev.isSuccessful()                         // passed / failed
]

// Wrap each value in quotes so commas inside values don&apos;t break the CSV
def line = row.collect { &apos;&quot;&apos; + it.toString().replace(&apos;&quot;&apos;, &apos;&quot;&quot;&apos;) + &apos;&quot;&apos; }.join(&apos;,&apos;)

// Only one thread writes at a time; header is written once
synchronized (org.apache.jmeter.util.JMeterUtils) {
    def f = new File(path)
    if (!f.exists()) {
        f.parentFile?.mkdirs()
        f &lt;&lt; &apos;&quot;time&quot;,&quot;thread&quot;,&quot;username&quot;,&quot;category&quot;,&quot;prod_id&quot;,&quot;auth_token&quot;,&quot;status&quot;,&quot;success&quot;\n&apos;
    }
    f &lt;&lt; line + &apos;\n&apos;
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PostProcessor>
