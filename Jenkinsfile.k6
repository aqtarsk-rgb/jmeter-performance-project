pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 10, unit: 'MINUTES')
    }

    environment {
        K6_IMAGE = 'grafana/k6:latest'
        K6_SCRIPT = 'k6/scripts/smoke-test.js'
        RESULTS_DIR = 'k6/results'
    }

    stages {

        stage('Verify Docker') {
            steps {
                sh '''
                    export PATH="/usr/local/bin:$PATH"

                    echo "Docker executable:"
                    which docker

                    echo "Docker version:"
                    docker --version

                    echo "Docker daemon:"
                    docker info
                '''
            }
        }

        stage('Prepare Results Directory') {
            steps {
                sh '''
                    mkdir -p "$RESULTS_DIR"

                    if [ ! -f "$K6_SCRIPT" ]; then
                        echo "ERROR: k6 script not found: $K6_SCRIPT"
                        exit 1
                    fi
                '''
            }
        }

        stage('Pull k6 Docker Image') {
            steps {
                sh '''
                    export PATH="/usr/local/bin:$PATH"
                    docker pull "$K6_IMAGE"
                '''
            }
        }

        stage('Run k6 Performance Test') {
            steps {
                sh '''
                    export PATH="/usr/local/bin:$PATH"

                    docker run --rm                         -v "$WORKSPACE:/work"                         -w /work                         "$K6_IMAGE"                         run "$K6_SCRIPT"
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'k6/results/**',
                             allowEmptyArchive: true

            echo 'k6 pipeline execution completed.'
        }

        success {
            echo 'k6 performance test PASSED.'
        }

        failure {
            echo 'k6 performance test FAILED. Check the console output.'
        }
    }
}
